# Copy this file to .env at the repository root. Keep the service account outside the repo.
FIREBASE_SERVICE_ACCOUNT_PATH=/mnt/c/secure/colony-info-service-account.json
COLONY_INFO_PORT=7000

# Optional overrides. Defaults reach Timberborn APIs running on the Windows host.
GAME_API_URL=http://host.docker.internal:7778/api/
COLONY_INFO_API_URL=http://host.docker.internal:7777/api/colony-info